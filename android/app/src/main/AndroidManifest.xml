<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Handhelds have no touchscreen requirement: the app is usable with a gamepad. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <!-- Network: art from SteamGridDB, the Steam library and store details and trailers, only when the user asks. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- "All files access": the main storage mode (RNF-10); the folder picker is used on top to hand ROMs to emulators. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Long tasks of the Pods (a download) run in a foreground service with a notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Usage access (granted by the user in the system settings): play time from the app usage events (RF-40). -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

    <!-- Only the apps with a launcher activity are visible (RF-06); QUERY_ALL_PACKAGES is not needed. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".ZLauncherApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZLauncher">
        <!-- Launchable and selectable as the device Home (HOME + DEFAULT). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep link for installing a Pod: zlauncher://pod?url=... (§6, §11) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="zlauncher" android:host="pod" />
            </intent-filter>
        </activity>
        <!-- The window on the second display of a dual-screen device (hero area, or the grid with swapped roles). -->
        <activity
            android:name=".SecondaryActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity="dev.zlauncher.secondary"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density"
            android:stateNotNeeded="true" />
        <service
            android:name=".pods.work.PodWorkService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
